 "rolling": {
  "query": {
   "limit": 51,
   "measures": [
    "orders.revenue_7d"
   ],
   "timeDimensions": [
    {
     "dateRange": [
      "2026-01-01",
      "2026-01-10"
     ],
     "dimension": "orders.ordered_at",
     "granularity": "day"
    }
   ],
   "timezone": "UTC"
  },
  "response": {
   "dataSource": "default",
   "sql": {
    "aliasNameToMember": {
     "orders__ordered_at_day": "orders.ordered_at.day",
     "orders__revenue_7d": "orders.revenue_7d"
    },
    "dataSource": "default",
    "external": false,
    "lambdaQueries": {},
    "memberNames": [
     "orders.revenue_7d",
     "orders.ordered_at"
    ],
    "order": {
     "orders.ordered_at": "asc"
    },
    "preAggregations": [],
    "sql": [
     " WITH \ntime_series AS (  SELECT dates.f::timestamp date_from, dates.t::timestamp date_to \n  FROM (\n      select '2026-01-01T00:00:00.000' f, '2026-01-01T23:59:59.999' t \n   UNION ALL\n      select '2026-01-02T00:00:00.000' f, '2026-01-02T23:59:59.999' t \n   UNION ALL\n      select '2026-01-03T00:00:00.000' f, '2026-01-03T23:59:59.999' t \n   UNION ALL\n      select '2026-01-04T00:00:00.000' f, '2026-01-04T23:59:59.999' t \n   UNION ALL\n      select '2026-01-05T00:00:00.000' f, '2026-01-05T23:59:59.999' t \n   UNION ALL\n      select '2026-01-06T00:00:00.000' f, '2026-01-06T23:59:59.999' t \n   UNION ALL\n      select '2026-01-07T00:00:00.000' f, '2026-01-07T23:59:59.999' t \n   UNION ALL\n      select '2026-01-08T00:00:00.000' f, '2026-01-08T23:59:59.999' t \n   UNION ALL\n      select '2026-01-09T00:00:00.000' f, '2026-01-09T23:59:59.999' t \n   UNION ALL\n      select '2026-01-10T00:00:00.000' f, '2026-01-10T23:59:59.999' t \n  ) AS dates),\ncte_0 AS (  SELECT date_trunc('day', (\"orders\".ordered_at::timestamptz AT TIME ZONE 'UTC')) \"orders__ordered_at_day\", sum(\"orders\".total) \"orders__revenue_7d\" \n  FROM  app.orders  AS \"orders\"\n  WHERE ((\"orders\".ordered_at::timestamptz AT TIME ZONE 'UTC') >= $1::timestamptz AND (\"orders\".ordered_at::timestamptz AT TIME ZONE 'UTC') <= $2::timestamptz)\n  GROUP BY 1\n  ORDER BY  1  ASC),\ncte_1 AS (  SELECT \"time_series\".\"date_from\" \"orders__ordered_at_day\", sum(\"rolling_source\".\"orders__revenue_7d\") \"orders__revenue_7d\" \n  FROM  time_series  AS \"time_series\"\n  LEFT JOIN  cte_0  AS \"rolling_source\" ON \"rolling_source\".\"orders__ordered_at_day\" > DATEADD(day, -7, \"time_series\".\"date_to\") AND \"rolling_source\".\"orders__ordered_at_day\" <= \"time_series\".\"date_to\"\n  GROUP BY 1\n  ORDER BY  1  ASC)\nSELECT \"fk_aggregate\".\"orders__ordered_at_day\" \"orders__ordered_at_day\", \"fk_aggregate\".\"orders__revenue_7d\" \"orders__revenue_7d\" \nFROM  cte_1  AS \"fk_aggregate\"\nORDER BY  1  ASC\nLIMIT 51",
     [
      "2025-12-25T00:00:00.000",
      "2026-01-10T23:59:59.999"
     ]
    ],
    "timeDimensionAlias": "orders__ordered_at_day",
    "timeDimensionField": "orders.ordered_at"
   }
  }
