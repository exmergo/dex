    ],
    "order": {
     "orders.revenue": "desc"
    },
    "preAggregations": [],
    "sql": [
     "SELECT \"orders\".status \"orders__status\", date_trunc('month', (\"orders\".ordered_at::timestamptz AT TIME ZONE 'UTC')) \"orders__ordered_at_month\", sum(\"orders\".total) \"orders__revenue\", count(\"orders\".id) \"orders__count\" \nFROM  app.orders  AS \"orders\"\nWHERE (\"orders\".ordered_at >= $1::timestamptz AND \"orders\".ordered_at <= $2::timestamptz) AND (\"orders\".status IN ($3, $4))\nGROUP BY 1, 2\nHAVING (sum(\"orders\".total) > $5)\nORDER BY  3  DESC\nLIMIT 10",
